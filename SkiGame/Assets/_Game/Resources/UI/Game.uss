/* Last Run - one stylesheet for the whole game. Palette: ink #1B1430, paper #F5EBD8, amber #FFC64A,
   red #E8455A, green #57D18A, snow #EEF3FA. Comic look: bold caps, ink outlines, tilted paper cards. */

.root {
    flex-grow: 1;
    color: rgb(245, 235, 216);
    font-size: 26px;
    -unity-font-definition: resource("Fonts/BarlowSemiCondensed-SemiBold");
    -unity-font-style: normal;
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fill {
    flex-grow: 1;
}

.row {
    flex-direction: row;
    align-items: center;
}

.center {
    align-items: center;
    justify-content: center;
}

.ink-text {
    color: rgb(27, 20, 48);
}

.outlined {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

/* ---- paper cards --------------------------------------------------------------------- */

.card {
    background-color: rgb(245, 235, 216);
    color: rgb(27, 20, 48);
    border-width: 4px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 14px 22px;
}

.card-dark {
    background-color: rgba(27, 20, 48, 0.86);
    color: rgb(245, 235, 216);
    border-width: 3px;
    border-color: rgb(245, 235, 216);
    border-radius: 6px;
    padding: 12px 20px;
}

.shadowed {
    border-bottom-width: 9px;
    border-right-width: 7px;
}

.tilt-left {
    rotate: -2deg;
}

.tilt-right {
    rotate: 1.5deg;
}

.title {
    font-size: 104px;
    color: rgb(255, 198, 74);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(27, 20, 48);
    letter-spacing: 6px;
    rotate: -3deg;
}

.subtitle {
    font-size: 30px;
    letter-spacing: 5px;
    color: rgb(238, 243, 250);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.h1 {
    font-size: 54px;
    letter-spacing: 2px;
}

.h2 {
    font-size: 36px;
    letter-spacing: 1px;
}

.small {
    font-size: 21px;
    -unity-font-style: normal;
}

.tiny {
    font-size: 17px;
    -unity-font-style: normal;
}

.accent {
    color: rgb(255, 198, 74);
}

.good {
    color: rgb(87, 209, 138);
}

.bad {
    color: rgb(232, 69, 90);
}

/* ---- buttons ------------------------------------------------------------------------- */

.btn {
    background-color: rgb(255, 198, 74);
    color: rgb(27, 20, 48);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 8px 26px 6px 26px;
    margin: 6px;
    font-size: 30px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
    transition-duration: 0.08s;
}

.btn:hover {
    background-color: rgb(255, 222, 140);
    translate: 0 -3px;
}

.btn:active {
    translate: 0 3px;
    border-bottom-width: 4px;
}

.btn-plain {
    background-color: rgb(245, 235, 216);
}

.btn-small {
    font-size: 22px;
    padding: 6px 16px;
}

/* ---- HUD ----------------------------------------------------------------------------- */

.hud-corner {
    position: absolute;
    margin: 34px 44px;
}

.hud-tl {
    left: 0;
    top: 0;
}

.hud-tr {
    right: 0;
    top: 0;
    align-items: flex-end;
}

.hud-bl {
    left: 0;
    bottom: 0;
}

.hud-br {
    right: 0;
    bottom: 0;
    align-items: flex-end;
}

.hud-timer {
    font-size: 64px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(27, 20, 48);
    color: rgb(238, 243, 250);
}

.hud-speed {
    font-size: 76px;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(27, 20, 48);
    color: rgb(238, 243, 250);
}

.hud-unit {
    font-size: 24px;
    margin-left: 8px;
    margin-top: 30px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.hud-badge {
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 5px;
    padding: 3px 14px;
    font-size: 22px;
    letter-spacing: 2px;
    color: rgb(245, 235, 216);
    align-self: flex-start;
}

.hud-penalty {
    font-size: 30px;
    color: rgb(232, 69, 90);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.hud-score {
    font-size: 64px;
    color: rgb(255, 198, 74);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.hud-centre {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    align-items: center;
}

.toast {
    font-size: 50px;
    color: rgb(255, 198, 74);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(27, 20, 48);
    rotate: -2deg;
    transition-property: opacity, scale, translate;
    transition-duration: 0.25s;
    opacity: 1;
}

.toast-sub {
    font-size: 32px;
    color: rgb(238, 243, 250);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.toast-hidden {
    opacity: 0;
    scale: 0.7 0.7;
    translate: 0 20px;
}

.toast-bad {
    color: rgb(232, 69, 90);
}

.hud-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 11%;
    align-items: center;
}

.gauge {
    width: 200px;
    height: 200px;
}

.gauge-wide {
    width: 420px;
    height: 74px;
}

.hint {
    font-size: 22px;
    color: rgb(238, 243, 250);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
    margin-top: 4px;
}

.key {
    background-color: rgb(245, 235, 216);
    color: rgb(27, 20, 48);
    border-width: 3px;
    border-bottom-width: 6px;
    border-color: rgb(27, 20, 48);
    border-radius: 5px;
    padding: 1px 10px;
    margin: 2px 6px 2px 0;
    font-size: 21px;
    min-width: 34px;
    -unity-text-align: middle-center;
}

.keys-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

/* ---- goggles and fades ---------------------------------------------------------------- */

.goggles {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(27, 20, 48);
    transition-property: opacity;
    transition-duration: 0.5s;
}

.letterbox {
    position: absolute;
    left: 0;
    right: 0;
    height: 11%;
    background-color: rgb(27, 20, 48);
    transition-property: height;
    transition-duration: 0.8s;
}

.letterbox-hidden {
    height: 0;
}

.letterbox-top {
    top: 0;
}

.letterbox-bottom {
    bottom: 0;
}

/* ---- menu ---------------------------------------------------------------------------- */

.menu-title-box {
    position: absolute;
    left: 3%;
    top: 4%;
}

.menu-chars {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2.5%;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;          /* every card as tall as the tallest */
}

.char-card {
    width: 300px;
    margin: 0 12px;
    padding: 6px 16px 10px 16px;
    background-color: rgb(245, 235, 216);
    color: rgb(27, 20, 48);
    border-width: 4px;
    border-bottom-width: 10px;
    border-right-width: 7px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    transition-property: translate, background-color, scale;
    transition-duration: 0.12s;
}

.char-card:hover {
    translate: 0 -14px;
    background-color: rgb(255, 232, 170);
}

.char-card-selected {
    translate: 0 -14px;
    background-color: rgb(255, 232, 170);
}

.char-name {
    font-size: 36px;
    letter-spacing: 2px;
}

.char-gear {
    font-size: 20px;
    letter-spacing: 3px;
    color: rgb(27, 20, 48);
    padding: 1px 10px;
    border-radius: 4px;
    align-self: flex-start;
    margin-bottom: 6px;
}

.char-trait {
    font-size: 21px;
}

.char-text {
    font-size: 17px;
    -unity-font-style: normal;
    white-space: normal;
}

.menu-corner {
    position: absolute;
    right: 3%;
    top: 4%;
    align-items: flex-end;
}

.menu-prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24%;
    align-items: center;
}

/* ---- dialogs ------------------------------------------------------------------------- */

.dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(27, 20, 48, 0.6);
    align-items: center;
    justify-content: center;
}

.dialog {
    min-width: 640px;
    max-width: 1100px;
    padding: 26px 40px 30px 40px;
}

.dialog-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 7px 0;
}

.dialog-label {
    font-size: 26px;
    margin-right: 30px;
}

.slider {
    width: 300px;
    height: 32px;
    margin: 0;
}

/* Sliders: an ink-outlined groove, the part up to the knob filled in yellow, a round cream knob. */
.slider.unity-base-slider--horizontal .unity-base-slider__drag-container {
    height: 32px;
}

.slider.unity-base-slider--horizontal .unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    background-color: rgb(222, 208, 184);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 7px;
}

.slider.unity-base-slider--horizontal .unity-base-slider__fill {
    background-color: rgb(255, 198, 74);
    border-radius: 4px;
}

.slider.unity-base-slider--horizontal .unity-base-slider__dragger {
    top: 50%;
    width: 26px;
    height: 26px;
    margin-top: -13px;
    margin-left: 0;
    background-color: rgb(245, 235, 216);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 13px;
}

.slider.unity-base-slider--horizontal:hover .unity-base-slider__dragger {
    background-color: rgb(255, 198, 74);
}

.slider .unity-base-slider__dragger-border {
    display: none;
}

/* Scroll bars: no arrow buttons, a slim groove and a rounded ink-outlined yellow handle. */
.unity-scroller--vertical {
    width: 18px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin-left: 4px;
}

.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical > .unity-scroller__slider {
    margin: 2px 0;
    width: 18px;
}

.unity-scroller--vertical .unity-base-slider--vertical .unity-base-slider__tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 8px;
    margin-left: -4px;
    background-color: rgba(27, 20, 48, 0.15);
    border-width: 0;
    border-radius: 4px;
}

.unity-scroller--vertical .unity-base-slider--vertical .unity-base-slider__dragger {
    left: 50%;
    width: 16px;
    margin-left: -8px;
    background-color: rgb(255, 198, 74);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 8px;
}

.unity-scroller--vertical .unity-base-slider--vertical .unity-base-slider__dragger-border {
    display: none;
}

.unity-scroller--horizontal {
    display: none;
}

.board {
    margin-top: 10px;
    min-width: 520px;
}

.board-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 12px;
    font-size: 25px;
    border-radius: 4px;
}

.board-row-me {
    background-color: rgb(255, 198, 74);
}

.board-rank {
    width: 50px;
}

.board-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.name-box {
    flex-direction: row;
    overflow: hidden;
}

.name-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.name-sliding {
    flex-shrink: 0;
    flex-grow: 0;
    overflow: visible;
    text-overflow: clip;
}

.board-guest {
    flex-shrink: 0;
    margin: 4px 4px 4px 2px;
    padding: 0 4px;
    font-size: 13px;
    color: rgb(245, 235, 216);
    background-color: rgb(120, 112, 130);
    border-radius: 3px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    -unity-text-align: middle-center;
}

.clip-icon {
    width: 22px;
    height: 16px;
}

.board-who {
    flex-shrink: 0;
    width: 70px;
    margin: 2px 10px 2px 6px;
    padding: 0 4px;
    font-size: 16px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    -unity-text-align: middle-center;
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(27, 20, 48);
}

.board-who-none {
    border-width: 0;
}

.board-value {
    flex-shrink: 0;
    min-width: 92px;
    -unity-text-align: middle-right;
}

.board-wait {
    margin: 10px 12px;
    color: rgb(90, 84, 100);
}

.results {
    position: absolute;
    right: 3%;
    top: 12%;
    width: 600px;
    rotate: 1.2deg;
}

.results-big {
    font-size: 78px;
    -unity-text-align: middle-center;
}

.banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 6%;
    align-items: center;
}

.banner-text {
    font-size: 84px;
    color: rgb(255, 198, 74);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(27, 20, 48);
    rotate: -2deg;
    letter-spacing: 3px;
}

/* ---- subtitles ------------------------------------------------------------------------ */

.subs {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 13%;
    align-items: center;
}

.sub-box {
    background-color: rgb(245, 235, 216);
    color: rgb(27, 20, 48);
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: rgb(27, 20, 48);
    border-radius: 8px;
    padding: 10px 26px;
    max-width: 1300px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.sub-name {
    font-size: 22px;
    letter-spacing: 3px;
    padding: 0 10px;
    border-radius: 4px;
    align-self: flex-start;
    color: rgb(27, 20, 48);
    margin-bottom: 2px;
}

.sub-text {
    font-size: 34px;
    white-space: normal;
    -unity-font-style: normal;
}

.skip {
    position: absolute;
    right: 3%;
    bottom: 3%;
    flex-direction: row;
    align-items: center;
}

/* ---- ski map --------------------------------------------------------------------------- */

.map-info {
    position: absolute;
    left: 4%;
    bottom: 6%;
    width: 560px;
    rotate: -1.5deg;
}

.map-title {
    position: absolute;
    left: 0;
    right: 0;
    top: 4%;
    align-items: center;
}

.slope-chip {
    width: 40px;
    height: 36px;
    margin-right: 12px;
    flex-shrink: 0;
}

.slope-icon {
    flex-grow: 1;
}

/* ---- minigame --------------------------------------------------------------------------- */

.mini-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 7%;
    align-items: center;
}

.mini-bar {
    width: 760px;
    height: 56px;
}

.prompt {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22%;
    align-items: center;
}

.name-field {
    width: 300px;
    font-size: 24px;
}

/* ---- comic lettering: Bangers for anything shouted, Barlow Semi Condensed (set on .root) for the rest ---- */

.title, .h1, .h2, .btn, .key, .hud-badge, .hud-timer, .hud-speed, .hud-score, .toast, .results-big, .banner-text, .sub-name {
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.name-field-big {
    width: 420px;
    font-size: 34px;
    margin: 14px 0;
}

/* ---- replays and live players ---------------------------------------------------------- */

.btn-watch {
    font-size: 18px;
    padding: 0 6px;
    margin: 0 0 0 10px;
    min-width: 34px;
    height: 28px;
    justify-content: center;
    align-items: center;
}

.btn-watch-wide {
    min-width: 92px;
}

.btn-watch-gap {
    width: 44px;
}

.board-small {
    min-width: 0;
    margin-top: 4px;
}

.board-small .board-row {
    font-size: 21px;
    padding: 1px 6px;
}

.replay-bar {
    position: absolute;
    top: 4%;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    background-color: rgb(245, 235, 216);
    border-width: 4px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 6px 18px;
    rotate: -1deg;
    color: rgb(27, 20, 48);
}

.replay-bar .h2 {
    color: rgb(27, 20, 48);
    margin-right: 6px;
}

.replay-chip {
    background-color: rgb(229, 57, 70);
    color: rgb(255, 255, 255);
    font-size: 22px;
    padding: 2px 10px;
    margin-right: 14px;
    border-radius: 4px;
}

.replay-clock {
    font-size: 30px;
    margin: 0 18px;
    min-width: 110px;
}

/* ---- notices and the shop ---------------------------------------------------------------- */

.notice {
    position: absolute;
    top: 9%;
    left: 50%;
    translate: -50% 0;
    align-items: center;
    background-color: rgb(255, 198, 74);
    border-width: 4px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 8px 26px;
    rotate: 1.5deg;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
}

.notice-hidden {
    opacity: 0;
    translate: -50% -30px;
}

.notice-title {
    font-size: 30px;
    color: rgb(27, 20, 48);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.notice-sub {
    font-size: 24px;
    color: rgb(27, 20, 48);
}

.shop {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(27, 20, 48, 0.55);
}

.shop-card {
    width: 600px;
    height: 88%;
    margin-right: 24px;
}

.shop-who {
    margin-left: 18px;
}

.shop-tabs {
    margin: 4px 0 8px 0;
}

.check {
    margin: 6px 0 8px 0;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: center;
}

.check .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 24px;
    height: 24px;
    margin-right: 10px;
    overflow: visible;
}

.check .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    background-color: rgb(245, 235, 216);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 5px;
    -unity-background-image-tint-color: rgb(27, 20, 48);
}

.check:checked .unity-toggle__checkmark {
    background-color: rgb(255, 198, 74);
}

.check.unity-toggle > .unity-toggle__label {
    min-width: 0;
    font-size: 26px;
    color: rgb(27, 20, 48);
}

.toggle-pair {
    flex-shrink: 0;
}

.toggle-option {
    min-width: 58px;
    margin: 0 0 0 4px;
}

.btn-selected {
    background-color: rgb(255, 198, 74);
}

.shop-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.shop-row {
    margin-bottom: 10px;
}

.shop-label {
    font-size: 22px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(27, 20, 48);
}

.shop-swatches, .shop-choices {
    flex-direction: row;
    flex-wrap: wrap;
}

.shop-swatch {
    width: 30px;
    height: 30px;
    margin: 2px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(27, 20, 48);
    border-radius: 15px;
    font-size: 16px;
    color: rgb(27, 20, 48);
}

.shop-swatch-locked {
    opacity: 0.6;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.shop-swatch-goal {
    width: 100%;
    margin-left: 4px;
}

.shop-swatch-new {
    border-width: 4px;
    border-color: rgb(143, 209, 79);
    font-size: 10px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    -unity-text-align: middle-center;
    color: rgb(27, 20, 48);
}

.shop-item-new {
    position: absolute;
    top: -9px;
    right: -8px;
    padding: 0 5px;
    font-size: 14px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(27, 20, 48);
    background-color: rgb(143, 209, 79);
    border-width: 2px;
    border-color: rgb(27, 20, 48);
    border-radius: 4px;
    rotate: 8deg;
}

.hud-news {
    margin-top: 6px;
    padding: 2px 10px;
    font-size: 22px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(27, 20, 48);
    background-color: rgb(143, 209, 79);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 5px;
    rotate: -2deg;
    align-self: flex-start;
}

.unlock-card {
    position: absolute;
    left: 24px;
    bottom: 14%;
    width: 380px;
    background-color: rgb(245, 235, 216);
    border-width: 4px;
    border-color: rgb(27, 20, 48);
    border-radius: 8px;
    rotate: 1.5deg;
    transition-property: opacity, translate;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-back;
}

.unlock-hidden {
    opacity: 0;
    translate: -440px 0;
}

.unlock-head {
    background-color: rgb(255, 198, 74);
    border-bottom-width: 4px;
    border-color: rgb(27, 20, 48);
    padding: 2px 14px;
    font-size: 30px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(27, 20, 48);
}

.unlock-row {
    padding: 10px 12px 12px 12px;
    align-items: center;
}

.unlock-pic {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 12px;
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-and-crop;
}

.unlock-pic-round {
    border-radius: 36px;
}

.unlock-pic-label {
    font-size: 20px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(245, 235, 216);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.unlock-words {
    flex-shrink: 1;
}

.unlock-name {
    font-size: 30px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    color: rgb(27, 20, 48);
}

.unlock-goal {
    font-size: 19px;
    color: rgb(27, 20, 48);
}

.unlock-where {
    margin-top: 2px;
    font-size: 15px;
    color: rgb(90, 84, 100);
}

.shop-swatch-on {
    border-width: 5px;
    border-color: rgb(255, 198, 74);
}

.shop-item {
    margin: 3px;
    padding: 4px 10px;
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 5px;
    background-color: rgb(245, 235, 216);
}

.shop-item-on {
    background-color: rgb(255, 198, 74);
}

.shop-item-locked {
    background-color: rgb(196, 190, 200);
    border-color: rgb(120, 112, 130);
}

.shop-item-name {
    font-size: 20px;
    color: rgb(27, 20, 48);
}

.shop-item-locked .shop-item-name {
    color: rgb(90, 84, 100);
}

.shop-item-goal {
    font-size: 15px;
    color: rgb(90, 84, 100);
}

.shop-view {
    width: 520px;
    height: 650px;
    border-width: 5px;
    border-color: rgb(27, 20, 48);
    border-radius: 8px;
    rotate: 1deg;
}

.mouse-icon {
    width: 22px;
    height: 32px;
    margin: 0 8px 0 2px;
}

.walkman-list {
    margin: 2px 0 8px 0;
}

.now-playing {
    position: absolute;
    right: 24px;
    bottom: 5%;
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 10px;
    background-color: rgb(27, 20, 48);
    border-width: 3px;
    border-color: rgb(255, 198, 74);
    border-radius: 8px;
    rotate: -1deg;
    transition-property: opacity, translate;
    transition-duration: 0.4s;
}

.now-playing-hidden {
    opacity: 0;
    translate: 0 30px;
}

.now-playing-note {
    font-size: 30px;
    margin-right: 10px;
    color: rgb(255, 198, 74);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.now-playing-cover {
    width: 88px;
    height: 88px;
    margin-right: 12px;
    border-width: 2px;
    border-color: rgb(255, 198, 74);
    border-radius: 4px;
}

.now-playing-title {
    font-size: 22px;
    color: rgb(245, 235, 216);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.now-playing-style {
    font-size: 15px;
    color: rgb(190, 180, 210);
}

.song-row {
    font-size: 22px;
    margin: 3px 0;
    -unity-text-align: middle-left;
}

.voice-badge {
    position: absolute;
    bottom: 4%;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    background-color: rgb(245, 235, 216);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 4px 12px;
    display: none;
}

.voice-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(229, 57, 70);
    margin-right: 8px;
}

.voice-text {
    font-size: 20px;
    color: rgb(27, 20, 48);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

/* ---- the controls, laid out like the keyboard --------------------------------------------- */

.controls {
    margin: 0 0 4px 0;
}

.controls-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.controls-pad {
    align-items: center;
}

.controls-keys {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
}

.controls-cell {
    align-items: center;
    width: 64px;
}

.key-square {
    width: 36px;
    margin: 0;
    -unity-text-align: middle-center;
    padding: 1px 0;
}

.controls-space-row {
    align-items: center;
    margin-top: 2px;
}

.key-space {
    width: 150px;
    -unity-text-align: middle-center;
}

.controls-what {
    font-size: 17px;
    color: rgb(238, 243, 250);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(27, 20, 48);
}

.controls-mouse {
    align-items: center;
    margin-left: 18px;
}

.controls-mouse .mouse-icon {
    width: 30px;
    height: 44px;
    margin: 0 0 2px 0;
}

.beer-gulp {
    align-items: center;
    margin: 10px 0 18px 0;
}

.beer-keys {
    justify-content: center;
    opacity: 0.85;
}

.shop-foot {
    justify-content: flex-end;
    flex-shrink: 0;
}

.shop-head {
    flex-shrink: 0;
    margin-bottom: 6px;
}

/* ---- settings sections ------------------------------------------------------------------------ */

.settings-tabs {
    margin-bottom: 8px;
    flex-shrink: 0;
}

.settings-body {
    min-width: 640px;
    min-height: 360px;
    padding-right: 8px;
}

.settings-scroll {
    max-height: 430px;
}

.keys-columns {
    align-items: flex-start;
    margin-top: 8px;
}

.keys-column {
    margin-right: 40px;
}

.keys-heading {
    font-size: 22px;
    color: rgb(27, 20, 48);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    margin: 8px 0 4px 0;
}

.keys-column .hint {
    color: rgb(27, 20, 48);
}

/* ---- the line for a place in the shared world ------------------------------------------------- */

.queue-badge {
    position: absolute;
    top: 2%;
    left: 50%;
    translate: -50% 0;
    background-color: rgb(245, 235, 216);
    color: rgb(27, 20, 48);
    border-width: 3px;
    border-color: rgb(27, 20, 48);
    border-radius: 6px;
    padding: 6px 18px;
    font-size: 24px;
    -unity-font-definition: resource("Fonts/Bangers-Regular");
    letter-spacing: 1px;
}

/* ---- the welcome: an account or a guest ------------------------------------------------------- */

.welcome-cols {
    align-items: flex-start;
    margin-top: 6px;
}

.welcome-col {
    width: 460px;
    padding-right: 24px;
}

.welcome-guest {
    border-left-width: 3px;
    border-color: rgb(27, 20, 48);
    padding-left: 28px;
    padding-right: 0;
}

.welcome .dialog-label {
    min-width: 120px;
}

.welcome .name-field {
    width: 260px;
}

/* ---- the little info button: hover for a note ---------------------------------------------------- */

.info-button {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 2px;
    border-color: rgb(27, 20, 48);
    background-color: rgb(255, 205, 64);
    margin-left: 8px;
    margin-top: 6px;
    align-items: center;
    justify-content: center;
}

.info-button-i {
    font-size: 15px;
    color: rgb(27, 20, 48);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.info-tip {
    position: absolute;
    width: 300px;
    white-space: normal;
    font-size: 17px;
    color: rgb(27, 20, 48);
    background-color: rgb(255, 250, 238);
    border-width: 2px;
    border-color: rgb(27, 20, 48);
    border-radius: 4px;
    padding: 6px 10px;
}

/* The frame rate, when the graphics settings show it. */
.fps-meter {
    position: absolute;
    top: 8px;
    left: 10px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    background-color: rgba(27, 20, 48, 0.6);
    padding: 1px 6px;
    border-radius: 4px;
}

/* Touch controls (phones and tablets): sizes in interface units, scaled with the screen. They keep to the
   corners and the top edge, off the middle of the screen, the time, the speed and the push ring. */
.touch-look {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The round stick, bottom left: the area takes the thumb a little outside the ring. */
.touch-stick {
    position: absolute;
    left: 30px;
    bottom: 30px;
    width: 340px;
    height: 340px;
}

.touch-stick-guide {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.touch-stick-ring {
    position: absolute;
    left: 50px;
    top: 50px;
    width: 240px;
    height: 240px;
    border-radius: 120px;
    background-color: rgba(27, 20, 48, 0.25);
    border-width: 3px;
    border-color: rgba(245, 235, 216, 0.6);
}

.touch-stick-split {
    position: absolute;
    left: 50%;
    top: 10px;
    bottom: 10px;
    width: 3px;
    margin-left: -1.5px;
    background-color: rgba(245, 235, 216, 0.5);
}

.touch-stick-label {
    position: absolute;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgba(245, 235, 216, 0.85);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(27, 20, 48);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.touch-stick-up {
    top: 14px;
}

.touch-stick-knob {
    position: absolute;
    left: 122px;
    top: 122px;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(255, 198, 74, 0.85);
    border-width: 4px;
    border-color: rgb(27, 20, 48);
}

/* The right thumb's buttons, bottom right. */
.touch-btn {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 70px;
    align-items: center;
    justify-content: center;
    background-color: rgba(27, 20, 48, 0.45);
    border-width: 4px;
    border-color: rgba(245, 235, 216, 0.75);
}

.touch-label {
    font-size: 30px;
    color: rgb(245, 235, 216);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.touch-main {
    right: 40px;
    bottom: 40px;
    width: 190px;
    height: 190px;
    border-radius: 95px;
    background-color: rgba(255, 198, 74, 0.55);
}

.touch-jump {
    right: 250px;
    bottom: 36px;
}

.touch-side {
    right: 60px;
    bottom: 250px;
    width: 130px;
    height: 130px;
    border-radius: 65px;
}

.touch-brake {
    right: 230px;
    bottom: 200px;
    width: 130px;
    height: 130px;
    border-radius: 65px;
}

.touch-grab {
    right: 400px;
    bottom: 180px;
    width: 110px;
    height: 110px;
    border-radius: 55px;
}

.touch-talk {
    right: 60px;
    bottom: 400px;
    width: 100px;
    height: 100px;
    border-radius: 50px;
}

.touch-down {
    background-color: rgba(255, 198, 74, 0.9);
    border-color: rgb(27, 20, 48);
}

/* Small buttons in a row along the top edge, between the time and the speed. */
.touch-top {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.touch-small {
    height: 58px;
    min-width: 70px;
    padding: 0 18px;
    margin: 0 6px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    background-color: rgba(27, 20, 48, 0.55);
    border-width: 3px;
    border-color: rgba(245, 235, 216, 0.75);
}

.touch-small .touch-label {
    font-size: 24px;
}

/* The song card, on touch below the speed (the buttons have the bottom right). */
.now-playing-touch {
    top: 190px;
    bottom: auto;
}

.touch-turn {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 64px;
    color: rgb(255, 198, 74);
    background-color: rgba(27, 20, 48, 0.92);
    -unity-font-definition: resource("Fonts/Bangers-Regular");
}

.hud-tricks-touch {
    position: absolute;
    left: 30px;
    top: 240px;
    right: auto;
    bottom: auto;
}
